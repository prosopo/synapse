# Synapse Configuration File
# This file contains all configuration options for the Synapse reverse proxy
# Generated by Ansible - do not edit manually
#
# Environment Variable Overrides:
# All configuration options can be overridden using environment variables with the AX_ prefix.
# For example: AX_MODE=proxy or AX_SERVER_UPSTREAM=http://localhost:8080

# Application operating mode
# - agent: Only access rules and monitoring (no proxy, pingora disabled)
# - proxy: Full reverse proxy functionality (default)
{% set synapse_mode = synapse_config_mode | default('agent') %}
mode: {{ synapse_mode | quote }}

{% if synapse_mode != 'agent' %}
# Redis Configuration
redis:
  # Redis connection URL for ACME cache storage
  url: {{ synapse_config_redis_url | default('redis://127.0.0.1/0') | quote }}
  # Namespace prefix for Redis ACME cache entries
  prefix: {{ synapse_config_redis_prefix | default('g0s:synapse') | quote }}
{% if synapse_config_redis_ssl is defined and synapse_config_redis_ssl %}
  # Redis SSL/TLS configuration
  ssl:
{% if synapse_config_redis_ssl_ca_cert_path is defined %}
    ca_cert_path: {{ synapse_config_redis_ssl_ca_cert_path | to_json }}
{% endif %}
{% if synapse_config_redis_ssl_client_cert_path is defined %}
    client_cert_path: {{ synapse_config_redis_ssl_client_cert_path | to_json }}
{% endif %}
{% if synapse_config_redis_ssl_client_key_path is defined %}
    client_key_path: {{ synapse_config_redis_ssl_client_key_path | to_json }}
{% endif %}
{% if synapse_config_redis_ssl_insecure is defined %}
    insecure: {{ synapse_config_redis_ssl_insecure | lower }}
{% endif %}
{% endif %}
{% endif %}

# Network Configuration
network:
  # The network interface to attach the XDP program to
  # Automatically detects primary interface from ansible_default_ipv4.interface if not specified
  iface: {{ synapse_config_network_iface | default(ansible_default_ipv4.interface | default('eth0')) | quote }}
  # Additional network interfaces for XDP attach (overrides iface if set)
  ifaces: {{ synapse_config_network_ifaces | default([]) | to_json }}
  # Disable XDP packet filtering (run without BPF/XDP)
  disable_xdp: {{ synapse_config_network_disable_xdp | default(false) | lower }}
  # IP version support mode: "ipv4", "ipv6", or "both" (default: "both")
  ip_version: {{ synapse_config_network_ip_version | default('both') | quote }}

# Gen0Sec Configuration
arxignis:
  # API key for Gen0Sec service
  api_key: {{ synapse_config_arxignis_api_key | default('') | quote }}
  # Base URL for Gen0Sec API
  base_url: {{ synapse_config_arxignis_base_url | default('https://api.gen0sec.com/v1') | quote }}
  # Enable sending access logs to arxignis server
  log_sending_enabled: {{ synapse_config_arxignis_log_sending_enabled | default(true) | lower }}
  # Include response body in access logs
  include_response_body: {{ synapse_config_arxignis_include_response_body | default(true) | lower }}
  # Maximum size for request/response bodies in access logs (bytes)
  max_body_size: {{ synapse_config_arxignis_max_body_size | default(1048576) }}
  # Threat MMDB Configuration
  threat:
    url: {{ synapse_config_arxignis_threat_url | default('https://download.gen0sec.com/v1') | quote }}
    path: {{ synapse_config_arxignis_threat_path | default('/var/lib/synapse') | quote }}
    headers: {{ synapse_config_arxignis_threat_headers | default(None) | to_json }}
    refresh_secs: {{ synapse_config_arxignis_threat_refresh_secs | default(300) }}
  # Captcha Configuration
  captcha:
    site_key: {{ synapse_config_arxignis_captcha_site_key | default(None) | to_json }}
    secret_key: {{ synapse_config_arxignis_captcha_secret_key | default(None) | to_json }}
    jwt_secret: {{ synapse_config_arxignis_captcha_jwt_secret | default(None) | to_json }}
    provider: {{ synapse_config_arxignis_captcha_provider | default('hcaptcha') | quote }}
    token_ttl: {{ synapse_config_arxignis_captcha_token_ttl | default(7200) }}
    cache_ttl: {{ synapse_config_arxignis_captcha_cache_ttl | default(300) }}

{% if synapse_mode != 'agent' %}
# GeoIP MMDB Configuration
geoip:
  country:
    url: {{ synapse_config_geoip_country_url | default('https://github.com/gen0sec/geoip-databases/raw/download/ipinfo_lite.mmdb') | quote }}
    path: {{ synapse_config_geoip_country_path | default('/var/lib/synapse') | quote }}
    headers: {{ synapse_config_geoip_country_headers | default(None) | to_json }}
  asn:
    url: {{ synapse_config_geoip_asn_url | default('https://github.com/gen0sec/geoip-databases/raw/download/GeoLite2-ASN.mmdb') | quote }}
    path: {{ synapse_config_geoip_asn_path | default('/var/lib/synapse') | quote }}
    headers: {{ synapse_config_geoip_asn_headers | default(None) | to_json }}
  city:
    url: {{ synapse_config_geoip_city_url | default('https://github.com/gen0sec/geoip-databases/raw/download/GeoLite2-City.mmdb') | quote }}
    path: {{ synapse_config_geoip_city_path | default('/var/lib/synapse') | quote }}
    headers: {{ synapse_config_geoip_city_headers | default(None) | to_json }}
  refresh_secs: {{ synapse_config_geoip_refresh_secs | default(28800) }}

# Content Scanning
content_scanning:
  enabled: {{ synapse_config_content_scanning_enabled | default(false) | lower }}
  clamav_server: {{ synapse_config_content_scanning_clamav_server | default('localhost:3310') | quote }}
  max_file_size: {{ synapse_config_content_scanning_max_file_size | default(10485760) }}
  scan_content_types: {{ synapse_config_content_scanning_scan_content_types | default(['text/html', 'application/x-www-form-urlencoded', 'multipart/form-data', 'application/json', 'text/plain']) | to_json }}
  skip_extensions: {{ synapse_config_content_scanning_skip_extensions | default([]) | to_json }}
  scan_expression: {{ synapse_config_content_scanning_scan_expression | default('http.request.method eq "POST" or http.request.method eq "PUT"') | quote }}
{% endif %}

# Logging Configuration
logging:
  level: {{ synapse_config_logging_level | default('info') | quote }}

# BPF Statistics Configuration
bpf_stats:
  enabled: {{ synapse_config_bpf_stats_enabled | default(true) | lower }}
  log_interval_secs: {{ synapse_config_bpf_stats_log_interval_secs | default(60) }}
  enable_dropped_ip_events: {{ synapse_config_bpf_stats_enable_dropped_ip_events | default(true) | lower }}
  dropped_ip_events_interval_secs: {{ synapse_config_bpf_stats_dropped_ip_events_interval_secs | default(30) }}

# TCP Fingerprinting Configuration
tcp_fingerprint:
  enabled: {{ synapse_config_tcp_fingerprint_enabled | default(true) | lower }}
  log_interval_secs: {{ synapse_config_tcp_fingerprint_log_interval_secs | default(60) }}
  enable_fingerprint_events: {{ synapse_config_tcp_fingerprint_enable_fingerprint_events | default(true) | lower }}
  fingerprint_events_interval_secs: {{ synapse_config_tcp_fingerprint_fingerprint_events_interval_secs | default(30) }}
  min_packet_count: {{ synapse_config_tcp_fingerprint_min_packet_count | default(3) }}
  min_connection_duration_secs: {{ synapse_config_tcp_fingerprint_min_connection_duration_secs | default(1) }}

# Daemon Configuration
daemon:
  enabled: {{ synapse_config_daemon_enabled | default(false) | lower }}
  pid_file: {{ synapse_config_daemon_pid_file | default('/var/run/synapse.pid') | quote }}
  working_directory: {{ synapse_config_daemon_working_directory | default('/') | quote }}
  stdout: {{ synapse_config_daemon_stdout | default('/var/log/synapse/access.log') | quote }}
  stderr: {{ synapse_config_daemon_stderr | default('/var/log/synapse/error.log') | quote }}
  user: {{ synapse_config_daemon_user | default(None) | to_json }}
  group: {{ synapse_config_daemon_group | default(None) | to_json }}
  chown_pid_file: {{ synapse_config_daemon_chown_pid_file | default(true) | lower }}

{% if synapse_mode != 'agent' %}
# Pingora Proxy System Configuration
pingora:
  proxy_address_http: {{ synapse_config_pingora_proxy_address_http | default('0.0.0.0:80') | quote }}
  proxy_address_tls: {{ synapse_config_pingora_proxy_address_tls | default('0.0.0.0:443') | quote }}
  proxy_certificates: {{ synapse_config_pingora_proxy_certificates | default('/etc/synapse/certs') | quote }}
  proxy_tls_grade: {{ synapse_config_pingora_proxy_tls_grade | default('medium') | quote }}
  default_certificate: {{ synapse_config_pingora_default_certificate | default('default') | quote }}
  upstreams_conf: {{ synapse_config_pingora_upstreams_conf | default('/etc/synapse/upstreams.yaml') | quote }}
  config_address: {{ synapse_config_pingora_config_address | default('0.0.0.0:3000') | quote }}
  config_api_enabled: {{ synapse_config_pingora_config_api_enabled | default(false) | lower }}
  master_key: {{ synapse_config_pingora_master_key | default('00000000-0000-0000-0000-000000000000') | quote }}
  log_level: {{ synapse_config_pingora_log_level | default('info') | quote }}
  healthcheck_method: {{ synapse_config_pingora_healthcheck_method | default('HEAD') | quote }}
  healthcheck_interval: {{ synapse_config_pingora_healthcheck_interval | default(2) }}
  proxy_protocol:
    enabled: {{ synapse_config_pingora_proxy_protocol_enabled | default(false) | lower }}
    timeout_ms: {{ synapse_config_pingora_proxy_protocol_timeout_ms | default(1000) }}

# ACME Configuration (Let's Encrypt certificate management)
acme:
  enabled: {{ synapse_config_acme_enabled | default(false) | lower }}
  port: {{ synapse_config_acme_port | default(9180) }}
  email: {{ synapse_config_acme_email | default(None) | to_json }}
  storage_type: {{ synapse_config_acme_storage_type | default(None) | to_json }}
  storage_path: {{ synapse_config_acme_storage_path | default('/var/lib/synapse/acme') | quote }}
  development: {{ synapse_config_acme_development | default(false) | lower }}
  redis_url: {{ synapse_config_acme_redis_url | default(None) | to_json }}
{% endif %}
